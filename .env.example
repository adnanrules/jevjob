# Copy to .env and fill in. Never commit .env.

# Jev (TypeSafe AI). A key from typesafe.ai goes here.
TYPESAFE_API_KEY=

# Using an OpenRouter key instead? Put it above and uncomment these two lines.
# TYPESAFE_BASE_URL=https://openrouter.ai/api
# TYPESAFE_DEFAULT_MODEL=typesafe/jev-1.13

# Optional, and only if you also use Joboid (the author's job-search tool): search the companies it follows too.
# JOBOID_DIR=/path/to/Joboid
