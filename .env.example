# Copy to .env and fill in. Never commit .env.

# Jev (TypeSafe AI). A key from typesafe.ai goes here.
TYPESAFE_API_KEY=

# Public job search (exa.ai). Required by the default find/search/MCP provider.
# Uses your existing Exa account; each call is bounded by max_queries (default 5).
EXA_API_KEY=
# Optional legacy tracked-company search only: --provider joboid
# JOBOID_DIR=C:/path/to/Joboid

# Using an OpenRouter key instead? Put it above and uncomment these two lines.
# TYPESAFE_BASE_URL=https://openrouter.ai/api
# TYPESAFE_DEFAULT_MODEL=typesafe/jev-1.13
