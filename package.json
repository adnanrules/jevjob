{
  "name": "jevjob",
  "version": "1.1.0",
  "description": "Rank job postings against your resume, one typed classification per requirement.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "build:places": "tsx scripts/build-places.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "tsx scripts/demo.ts",
    "eval": "tsx packages/eval/src/run.ts",
    "compare": "tsx scripts/compare.ts",
    "sweep": "tsx packages/eval/src/sweep.ts",
    "coverage": "tsx scripts/coverage.ts",
    "web": "npm run dev -w @jevjob/web",
    "jevjob": "tsx packages/harness/src/cli.ts",
    "mcp": "tsx packages/harness/src/mcp.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
